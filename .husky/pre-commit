# Fail-closed secret scan: block commits containing secrets.
# Emergency bypass (--no-verify) requires a mandatory follow-up full rescan.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not installed (winget install Gitleaks.Gitleaks / brew install gitleaks), commit blocked" >&2
  exit 1
fi
if ! gitleaks protect --staged --config .gitleaks.toml --verbose; then
  echo "secret detected in staged changes, commit blocked" >&2
  exit 1
fi

npm run check
