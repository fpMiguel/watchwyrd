{
  "name": "watchwyrd",
  "version": "0.4.0",
  "description": "AI-powered Stremio addon for movie & TV recommendations (Gemini, Perplexity, OpenAI)",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "dotenv -e .env.development -- cross-env RUN_API_TESTS=true vitest run tests/integration/",
    "test:record": "dotenv -e .env.development -- cross-env RUN_API_TESTS=true RECORD_RESPONSES=true vitest run tests/integration/",
    "test:all": "dotenv -e .env.development -- cross-env RUN_API_TESTS=true vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:all": "npm run check && npm run knip",
    "knip": "knip",
    "prepublishOnly": "npm run build",
    "precommit": "npm run check",
    "generate:logos": "node scripts/generate-logos.js"
  },
  "keywords": [
    "stremio",
    "addon",
    "gemini",
    "ai",
    "recommendations",
    "movies",
    "tv-series",
    "watchwyrd"
  ],
  "author": "",
  "license": "MIT",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fpMiguel/watchwyrd.git"
  },
  "bugs": {
    "url": "https://github.com/fpMiguel/watchwyrd/issues"
  },
  "homepage": "https://github.com/fpMiguel/watchwyrd#readme",
  "dependencies": {
    "@google/genai": "2.15.0",
    "@perplexity-ai/perplexity_ai": "0.38.1",
    "bottleneck": "^2.19.5",
    "cors": "^2.8.6",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "lru-cache": "11.5.2",
    "openai": "7.0.0",
    "opossum": "10.0.0",
    "p-retry": "8.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "undici": "8.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "26.1.2",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-istanbul": "4.1.10",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "4.0.1",
    "js-yaml": "5.2.2",
    "knip": "6.29.0",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "typescript-eslint": "8.65.0",
    "supertest": "^7.2.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
